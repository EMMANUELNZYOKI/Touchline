# Browser-side Supabase credentials (publishable/anon only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side Supabase credentials; never prefix the service-role key with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Exact email of the first Touchline platform operator; used only when no
# platform_admins row exists yet. Remove/change only through an audited process.
TOUCHLINE_PLATFORM_ADMIN_EMAIL=platform-owner@example.com
