# Touchline Supabase project: icmocslfyhnizdgbldhj
# Safe for browser use; these variables are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://icmocslfyhnizdgbldhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-side only. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://icmocslfyhnizdgbldhj.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Exact email for the first Touchline platform operator. Server-side only.
TOUCHLINE_PLATFORM_ADMIN_EMAIL=platform-owner@example.com

# Paystack server-side billing configuration. Never expose this in NEXT_PUBLIC_ variables.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
# Legacy Flutterwave configuration can remain set while existing transactions settle.
FLW_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLW_SECRET_HASH=YOUR_FLUTTERWAVE_WEBHOOK_SECRET_HASH
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN
# Secret used by the Vercel daily subscription-expiry cron.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET
